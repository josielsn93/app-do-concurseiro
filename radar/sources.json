{
  "trusted": {
    "domains": [".gov.br", ".jus.br", ".leg.br", ".mp.br"],
    "names": [
      "Diário Oficial da União",
      "Diário Oficial do Estado de São Paulo",
      "Tribunal de Justiça de São Paulo",
      "TJSP",
      "Governo do Estado de São Paulo",
      "Prefeitura de São Paulo",
      "Agência Brasil",
      "Agência Senado",
      "Agência Câmara de Notícias",
      "Folha de S.Paulo",
      "Folha Dirigida",
      "Estadão",
      "O Estado de S. Paulo",
      "G1",
      "O Globo",
      "UOL",
      "CNN Brasil",
      "Valor Econômico",
      "Poder360",
      "Metrópoles",
      "JOTA",
      "PCI Concursos",
      "Estratégia Concursos",
      "Direção Concursos"
    ]
  },
  "tracks": [
    {
      "id": "tjsp",
      "label": "TJ-SP (Escrevente)",
      "queries": [
        "\"TJSP\" OR \"TJ-SP\" concurso",
        "\"Tribunal de Justiça de São Paulo\" concurso escrevente"
      ]
    },
    {
      "id": "federal-sp",
      "label": "Justiça Federal, Trabalhista e Eleitoral (SP)",
      "queries": [
        "\"TRF3\" concurso",
        "\"TRT-2\" OR \"TRT 2\" concurso",
        "\"TRT-15\" OR \"TRT 15\" concurso",
        "\"TRE-SP\" concurso"
      ]
    },
    {
      "id": "tjs-sul",
      "label": "Justiça do Sul (RS, SC, PR)",
      "queries": [
        "\"TJRS\" OR \"TJ-RS\" concurso",
        "\"TJSC\" OR \"TJ-SC\" concurso",
        "\"TJPR\" OR \"TJ-PR\" concurso",
        "\"TRF4\" OR \"TRT-4\" OR \"TRT 4\" concurso"
      ]
    },
    {
      "id": "tjmg",
      "label": "TJ-MG",
      "queries": ["\"TJMG\" OR \"TJ-MG\" concurso"]
    },
    {
      "id": "pmsp",
      "label": "Prefeitura de São Paulo",
      "queries": [
        "\"Prefeitura de São Paulo\" concurso",
        "concurso \"APPGG\" OR \"Assistente de Gestão de Políticas Públicas\" São Paulo"
      ]
    },
    {
      "id": "pcsp",
      "label": "Polícia Civil de SP",
      "queries": [
        "\"Polícia Civil\" \"São Paulo\" concurso",
        "concurso \"PC-SP\" escrivão investigador"
      ]
    },
    {
      "id": "educacao",
      "label": "Educação (técnico-administrativo)",
      "queries": [
        "concurso técnico administrativo em educação \"IFSP\" OR \"USP\" OR \"Unesp\" OR \"Unicamp\"",
        "concurso \"Secretaria da Educação\" \"São Paulo\""
      ]
    }
  ]
}
