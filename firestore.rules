rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Single-user app: only the owner's Google account may use this project.
    // Other accounts can sign in to the page but get no access to any data.
    function isAppOwner() {
      return signedIn() && request.auth.uid == 'tSPFagkJtBRaMm332MY5KujyKZw1';
    }

    function owns(uid) {
      return isAppOwner() && request.auth.uid == uid;
    }

    // Estado de estudo sincronizado (um documento compactado por conta).
    match /users/{uid}/estado/{docId} {
      allow read: if owns(uid) && docId == 'atual';
      allow create, update: if owns(uid) && docId == 'atual'
        && request.resource.data.keys().hasOnly(['v', 'format', 'deviceId', 'updatedAt', 'rawBytes', 'data'])
        && request.resource.data.v == 1
        && request.resource.data.format in ['gzip-base64', 'json']
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 128
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 64
        && request.resource.data.rawBytes is int
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000;
      allow delete: if false;
    }

    // Formato antigo: só leitura, para a migração automática.
    match /users/{uid}/snapshots/{snapshotId} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /users/{uid}/aulas/{aulaId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && aulaId.matches('a_[0-9a-f]+_[0-9]+')
        && request.resource.data.keys().hasOnly(['version', 'text', 'updatedAt'])
        && request.resource.data.version == 1
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 30000
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
